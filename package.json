{
  "name": "command-session-delete",
  "version": "1.0.0",
  "description": "DSH 插件：会话列表右键「删除会话」，物理删除会话记录（DSH 原生只支持归档）。A DeepSeek Harness plugin adding real session deletion to the context menu.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-market",
    "deepseek-harness",
    "deepseek",
    "session",
    "session-management",
    "delete-session",
    "conversation",
    "context-menu",
    "archive"
  ],
  "dsh": {
    "id": "command-session-delete",
    "name": "会话删除",
    "version": "1.0.0",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alst123/command-session-delete.git"
  }
}
